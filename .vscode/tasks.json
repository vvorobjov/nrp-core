{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "options": {
        "env": {
            "NEST_INSTALL_DIR": "${env:NRP_DEPS_INSTALL_DIR}"
        }
    },
    "tasks": [
        {
            "label": "CMake Debug",
            "type": "shell",
            "command": "bash ${workspaceFolder}/.ci/11-prepare-build.sh",
            "options": {
                "env": {
                    "CMAKE_ARGS": "-DCMAKE_BUILD_TYPE=Debug"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake Debug No Test",
            "type": "shell",
            "command": "bash ${workspaceFolder}/.ci/11-prepare-build.sh",
            "options": {
                "env": {
                    "CMAKE_ARGS": "-DCMAKE_BUILD_TYPE=Debug -DENABLE_TESTING=OFF"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake Release",
            "type": "shell",
            "command": "bash ${workspaceFolder}/.ci/11-prepare-build.sh",
            "options": {
                "env": {
                    "CMAKE_ARGS": "-DCMAKE_BUILD_TYPE=Release"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Make all",
            "type": "shell",
            "command": "bash ${workspaceFolder}/.ci/20-build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
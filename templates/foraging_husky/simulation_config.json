{
    "SimulationName": "Foraging Husky (drive-state SNN)",
    "SimulationDescription": "A Husky robot driven by a NEST spiking network with two competing drive populations (HUNGRY / SATED). It forages for green food when hungry, parks at a blue rest zone when sated, and reflex-avoids grey obstacles. Gazebo provides the camera and robot body, NEST runs the brain in-image. Tracked in EBR2-32.",
    "SimulationTimeout": 60,
    "EngineConfigs": [
        {
            "EngineType": "gazebo_grpc",
            "EngineName": "gazebo",
            "ServerAddress": "localhost:9020",
            "EngineProcCmd": "xvfb-run-nrp /usr/bin/gzserver",
            "GazeboWorldFile": "foraging_world.sdf",
            "GazeboSDFModels": [
                {
                    "Name": "husky",
                    "File": "husky.sdf",
                    "InitPose": "0.0 0.0 0.19 0 0 0"
                }
            ],
            "EngineProcStartParams": ["--verbose"]
        },
        {
            "EngineType": "nest_json",
            "EngineName": "nest",
            "NestInitFileName": "brain.py",
            "EngineEnvParams": ["PYNEST_QUIET=1"]
        },
        {
            "EngineType": "datatransfer_grpc_engine",
            "EngineName": "datatransfer_engine",
            "MQTTBroker": "localhost:1883",
            "simulationID": "0",
            "MQTTPrefix": "localhost",
            "ProtobufPackages": ["Gazebo", "Dump"],
            "dumps": []
        }
    ],
    "DataPackProcessingFunctions": [
        {
            "Name": "camera_to_sensory",
            "FileName": "camera_to_sensory.py"
        },
        {
            "Name": "obstacle_to_avoidance",
            "FileName": "obstacle_to_avoidance.py"
        },
        {
            "Name": "drive_update",
            "FileName": "drive_update.py"
        },
        {
            "Name": "motors_to_husky",
            "FileName": "motors_to_husky.py"
        }
    ]
}

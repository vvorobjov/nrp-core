{
    // Canonical image: jammy / Humble / Python 3.10.
    // Build with:  ./build_nrp_core_image.sh nrp-nest-gazebo
    "image": "nrp-local/nrp-nest-gazebo:local",

    "customizations": {
      "vscode": {
        "extensions": [
          "mhutchie.git-graph",
          "ms-vscode.cpptools-extension-pack",
          "IBM.output-colorizer"
        ]
      }
    },
    "onCreateCommand": ".devcontainer/devcontainer-setup.bash",
    "containerEnv": {
        "CMAKE_CACHE_FILE": ".ci/cmake_cache/nest-gazebo.cmake",
        // For OpenSim experiments:
        // "CMAKE_CACHE_FILE": ".ci/cmake_cache/opensim.cmake",
        "NRP_XPRA_PORT": "9876"
    },
    "forwardPorts": [9876]
  }

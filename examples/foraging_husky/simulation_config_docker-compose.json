{
    "SimulationName": "foraging_husky_simulation",
    "SimulationDescription": "Husky with a drive-state SNN foraging for food / resting at blue zones, with grey-obstacle reflex. Compose variant: NEST runs as a docker-registry.ebrains.eu/nest/nest-simulator:3.9 sidecar with nest-server REST, Gazebo runs as nrp-gazebo (or nrp-xpra-gazebo for the visualised topology), NRPCoreSim runs as nrp-vanilla and talks to both over the docker-compose network.",
    "SimulationTimeout": 60,
    "EngineConfigs": [
        {
            "EngineType": "gazebo_grpc",
            "EngineName": "gazebo",
            "GazeboWorldFile": "foraging_world.sdf",
            "GazeboSDFModels": [
                {
                    "Name": "husky",
                    "File": "/experiment/husky.sdf",
                    "InitPose": "0.0 0.0 0.19 0 0 0"
                }
            ],
            "EngineProcStartParams": ["--verbose"],
            "ServerAddress": "nrp-gazebo:9000",
            "EngineLaunchCommand": {
                "LaunchType": "EmptyLaunchCommand"
            }
        },
        {
            "EngineType": "nest_server",
            "EngineName": "nest",
            "NestInitFileName": "brain_nest_server.py",
            "EngineEnvParams": ["PYNEST_QUIET=1"],
            "NestServerHost": "nrp-nest-simulator",
            "NestServerPort": 9000,
            "EngineLaunchCommand": {
                "LaunchType": "EmptyLaunchCommand"
            }
        }
    ],
    "DataPackProcessingFunctions": [
        {
            "Name": "camera_to_sensory",
            "FileName": "camera_to_sensory.py"
        },
        {
            "Name": "obstacle_to_avoidance",
            "FileName": "obstacle_to_avoidance.py"
        },
        {
            "Name": "drive_update",
            "FileName": "drive_update.py"
        },
        {
            "Name": "motors_to_husky",
            "FileName": "motors_to_husky.py"
        }
    ]
}

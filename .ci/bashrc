#!/usr/bin/env bash

# TODO: Check the duplication of the env variables export (here and in Dockerfile)
export PYTHONPATH=$NRP_INSTALL_DIR/lib/python3.8/site-packages:$PYTHONPATH
export LD_LIBRARY_PATH=$NRP_INSTALL_DIR/lib:$LD_LIBRARY_PATH
export PATH=$PATH:$NRP_INSTALL_DIR/bin:$HOME/.local/bin

# ROS 2 Foxy (replaces ROS 1 Noetic + catkin_ws). We also source the
# colcon install space for nrp_ros_msgs, built by src/nrp_ros/CMakeLists.txt.
[ -f /opt/ros/foxy/setup.sh ] && . /opt/ros/foxy/setup.sh

export ROS2_WS=${HOME}/ros2_ws
[ -f ${ROS2_WS}/install/setup.bash ] && . ${ROS2_WS}/install/setup.bash

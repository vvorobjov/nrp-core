#!/usr/bin/env bash

# TODO: Check the duplication of the env variables export (here and in Dockerfile)
_PYVER=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null || echo "3.8")
export PYTHONPATH=$NRP_INSTALL_DIR/lib/python${_PYVER}/site-packages:$PYTHONPATH
unset _PYVER
export LD_LIBRARY_PATH=$NRP_INSTALL_DIR/lib:$LD_LIBRARY_PATH
export PATH=$PATH:$NRP_INSTALL_DIR/bin:$HOME/.local/bin

# ROS 2 — source whichever distribution is installed. foxy is the
# Ubuntu 20.04 LTS release, humble the 22.04 one. The loop breaks on
# the first match, so ordering only matters if both are installed
# (shouldn't happen in a nrp-core image).
for _ros_distro in humble foxy; do
    [ -f /opt/ros/${_ros_distro}/setup.sh ] && . /opt/ros/${_ros_distro}/setup.sh && break
done
unset _ros_distro

export ROS2_WS=${HOME}/ros2_ws
[ -f ${ROS2_WS}/install/setup.bash ] && . ${ROS2_WS}/install/setup.bash

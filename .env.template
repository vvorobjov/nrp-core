NRP_CORE_TAG=local
# Local build namespace produced by build_nrp_core_image.sh (default).
# CI publishes hbpneurorobotics/nrp-vanilla and hbpneurorobotics/nrp-nest-gazebo
# to Docker Hub, but the docker-compose examples also need nrp-gazebo, which is
# not published, so the local namespace stays the default.
NRP_DOCKER_REGISTRY=nrp-local
